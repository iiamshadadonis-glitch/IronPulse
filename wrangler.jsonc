{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ironpulse-gym",
  "compatibility_date": "2026-08-01",
  "pages_build_output_dir": "./public",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ironpulse-gym-db",
      "database_id": "893e7d29-fa72-413d-9415-5d93b1c3bc6e"
    }
  ],
  "vars": {
    "SITE_URL": "https://ironpulse-gym.pages.dev",
    "SITE_NAME": "IronPulse Gym",
    "ADMIN_EMAILS": "admin@ironpulse-gym.local",
    "ADMIN_DEVELOPMENT_BYPASS": "false",
    "WHATSAPP_ADMIN_NUMBER": "919381521966",
    "GREEN_API_ADMIN_NUMBER": "919381521966",
    "WHATSAPP_PHONE_NUMBER_ID": "",
    "WHATSAPP_OTP_TEMPLATE_NAME": "gym_member_otp",
    "GREEN_API_INSTANCE_ID": "",
    "MEDIA_PUBLIC_BASE_URL": "/api/media",
    "DEFAULT_CURRENCY": "INR",
    "APP_STORAGE_LIMIT_MB": "500",
    "SUBSCRIPTION_HORIZON_YEARS": "21",
    "STRIPE_FALLBACK_ENABLED": "false",
    "MEDIA_STORAGE_MODE": "d1-pages-no-r2",
    "ADMIN_LOGIN_EMAIL": "admin@ironpulse-gym.local"
  }
}
